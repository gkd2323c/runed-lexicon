# Runtime / generated work
.work/
_tmp/
translation-batch-preparer-workspace/
*-workspace/

# Python / Node / editor noise
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local credentials and environment
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx

# Logs and crash dumps
*.log
*.dmp

# Official game / Creation Club dictionary exports are local evidence.
# 排除规则不在本文件：平台检索工具会跳过 .gitignore / .git/info/exclude 排除的文件，
# Agent 将无法检索词典。规则改放 .git/info/exclude-dictionary（由本机 core.excludesFile
# 指向；平台不读该来源），使 git 排除保持、Agent 检索可见。新 clone 见 CLAUDE.md「本地数据」。

# MOD workspaces are local by default. Keep only the public directory contract.
mods/**
!mods/README.md

# Bethesda plugin/archive binaries, wherever they accidentally land.
*.esp
*.esm
*.esl
*.bsa
*.ba2

# Local xEdit distribution. The project-owned exporter script lives under
# .agents/skills/xedit-context-exporter/, not here.
tools/xEdit/**
!tools/xEdit/README.md

# External translator term corpus; provenance is documented but redistribution
# permission is not assumed.
tools/term-rules/*.txt

# Common native binaries should not be vendored accidentally.
*.exe
*.dll
*.pdb

# Local CLI configuration (settings, taste) must not ship with the repo.
.commandcode/

tools/Mutagen/
.agents/skills/mutagen-dialogue-exporter/scripts/DialogueExport/bin/
.agents/skills/mutagen-dialogue-exporter/scripts/DialogueExport/obj/

# 环境绑定操作文档，不随仓库发布。
.claude/
.agents/skills/hana-subagent-ops/

# Semantic-gate connection config carries a live API key; never commit.
semantic-gate.config.json
